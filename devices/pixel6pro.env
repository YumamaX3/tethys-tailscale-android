# Tethys device profile - Pixel 6 Pro
#
# Sourced by the BUILD pipeline, and only by it - and only for the leg that
# builds this device's ABI (see "Wire every device profile that builds this
# arch" in .github/workflows/build-android.yml). tools/check-device-profile.sh
# proves that sourcing happens and that the values below still agree with what
# the build actually does.
#
# The runtime section is the DAEMON's specification, not the module's. The module
# parses a fixed 18-key schema and deliberately tunes no Go runtime from the
# shell: a knob the daemon owns cannot be measured from outside it, so setting it
# there would be a guess wearing a setting's name (plan M9 power governor, M10
# MTU-derived MSS). Nothing in the module repo reads this file, and nothing
# should start.
#
# Every value below is marked with its provenance:
#
#   SEEN    - read this session from a named source, quoted in docs/PROVENANCE.md
#   PROBE   - NOT yet observed; a script must measure it on the device before it
#             may be trusted. A value present here is a *default to be replaced*,
#             never a claim.
#
# This file is sourced by POSIX sh. Keep it to KEY="value" lines and comments -
# no commands, no references to variables defined elsewhere. A profile that runs
# code when sourced is a program wearing a config's name.

# ----------------------------------------------------------------- identity
# Match rules: the module activates this profile only when the device reports
# these. `ro.product.device` is the authoritative field; the rest are guards.
TETHYS_PROFILE_ID="pixel6pro"
TETHYS_MATCH_REQUIRE="ro.product.device"
TETHYS_MATCH_VALUE="raven"            # PROBE - confirm with: getprop ro.product.device
TETHYS_MATCH_ANY="ro.product.vendor.device=raven ro.product.model=Pixel\\ 6\\ Pro"  # PROBE
TETHYS_PROFILE_LABEL="Google Pixel 6 Pro"

# ----------------------------------------------------------------- silicon
# SEEN (Wikipedia, Pixel 6): released 2021-10-28, shipped Android 12, Google
# Tensor, 12 GB RAM, 5003 mAh, Titan M2, 6.7" 3120x1440 LTPO 120 Hz.
# SEEN (Wikipedia, Google Tensor): first-generation Tensor; microarchitecture is
# "two large cores, two medium cores, and four small cores" (2+2+4); ARM64-based.
TETHYS_SOC_FAMILY="tensor"            # SEEN
TETHYS_SOC_GENERATION="1"             # SEEN (first generation)
TETHYS_CPU_TOPO="2+2+4"               # SEEN
TETHYS_CPU_CLUSTERS="4"               # = count of performance cores (2 large + 2 medium)
TETHYS_RAM_GB="12"                    # SEEN
TETHYS_BATTERY_MAH="5003"             # SEEN
TETHYS_ABI_PRIMARY="arm64-v8a"        # SEEN (ARM64-based SoC)
TETHYS_KERNEL_SERIES="5.10"           # PROBE - confirm with: uname -r
TETHYS_ANDROID_API=""                 # PROBE - confirm with: getprop ro.build.version.sdk

# ----------------------------------------------------------------- build (fork CI)
# This profile describes THIS device's leg. A Pixel 6 Pro is arm64-v8a, and the
# module's zip ships the arm64 payload alone - but that is the MODULE's choice,
# not the fork's: the release carries an arm artifact too, for 32-bit devices
# (plan §17 M2, "arm64 + arm artifacts"). The workflow skips any profile whose
# TETHYS_GOARCH does not match the leg being built, so a second device adds a
# second profile here rather than editing this one.
TETHYS_GOARCH="arm64"
TETHYS_BUILD_ABIS="arm64-v8a"
# GOARM64: the Go toolchain accepts GOARM64=v8.0..v9.x. Tensor is an ARMv8.2-A
# part, so v8.2 is the highest level this device is *known* to satisfy.
# PROBE - raise only after measuring on-device; a wrong level is an illegal
# instruction at runtime, not a build error.
TETHYS_GOARM64="v8.2"                 # PROBE (default; measured before trust)
TETHYS_CGO="1"                        # the release recipe builds with cgo
# The NDK release string is the full `rNNx`. android.sh builds both the directory
# name and the download URL from it (`android-ndk-$NDK_VERSION`,
# `android-ndk-${NDK_VERSION}-linux.zip`), so a bare "27c" would name a directory
# and a URL that do not exist. tools/check-device-profile.sh compares this against
# the constant inside patch 0001 and caught exactly that on its first run.
TETHYS_NDK_VERSION="r27c"             # SEEN - patch 0001 pins it, and this must agree
TETHYS_TUNE_LDFLAGS="-s -w -buildid=" # strip + reproducible build id
TETHYS_TUNE_GCFLAGS=""                # PROBE - no per-device tuning proven yet

# ----------------------------------------------------------------- runtime
# GOMAXPROCS: the Go scheduler's P count. Left at the default (all cores) the
# runtime will place work on the four small cores, waking clusters that cost more
# power than the work is worth on a VPN daemon that is idle almost always.
# Pinning to the 4 performance cores is a *reasoned* default from the confirmed
# 2+2+4 topology; the power benefit is PROBE - measure before claiming it.
TETHYS_GOMAXPROCS="4"                 # PROBE (reasoned from SEEN topology)
TETHYS_GOGC="100"                     # default; raise to trade RAM for CPU
TETHYS_GOMEMLIMIT=""                  # empty = unlimited; the device has 12 GB (SEEN)
TETHYS_NICE="-10"                     # daemon priority; PROBE on real device

# ----------------------------------------------------------------- network
# MSS: clamped segment size for the tunnel path. 1200 is the conservative,
# mobile-safe value widely used by tunnel daemons; it is NOT a property of this
# SoC and must not be described as one. PROBE - measure per-transport before
# tuning, and never above the path MTU.
TETHYS_MSS="1200"                     # PROBE
# TUN: SEEN in patches/0003 - defaultTunName() on android returns
# "tailscale0,userspace-networking", i.e. the daemon tries the interface and then
# falls back to its OWN userspace stack, and wgengine/netstack was patched to
# terminate DNS for it in-process. The module therefore does NOT create a TUN
# device and must not require one. (This field previously read "upstream" - the
# source falsified it.)
TETHYS_TUN_DEFAULT="tailscale0,userspace-networking"   # SEEN
TETHYS_TUN_MODE="userspace"                            # PROBE - which candidate wins on device
TETHYS_DNS_MODE="netd"                # netd owns resolver properties (see router notes)

# Socket marks: SEEN in patches/0002 (tsconst/linuxfw.go), and independently
# CROSS-CHECKED against the fetched Fwmark.h bit map.
#   mask               0x1e000000  = bits 25-28   (inside `reserved`, 21-28)
#   subnet-route mark  0x08000000  = bit 27
#   bypass mark        0x10020000  = bit 24 | bit 17 (protectedFromVpn)
# The patch claims "lower 0-20 bits are allocated by Android, 21-28 unused".
# Fwmark.h says exactly that. The claim is VERIFIED, not taken on faith.
# Consequence: Tailscale parks its marks inside `reserved` - AOSP's own future
# space. That is a collision risk to watch on every platform bump, not a gift.
TETHYS_FWMARK_MASK="0x1e000000"
TETHYS_FWMARK_BYPASS="0x10020000"

# ----------------------------------------------------------------- platform hazards
# The rule-priority ladder this device's netd installs, read from
# system/netd/server/RouteController.h (sha256 98cad8db...). Recorded so the
# router can be reasoned about without guessing, and so a future AOSP change is
# detectable as a *diff* rather than a mystery.
#
#   10000 VPN_OVERRIDE_SYSTEM      20000 LOCAL_NETWORK
#   11000 VPN_OVERRIDE_OIF         21000 TETHERING
#   12000 VPN_OUTPUT_TO_LOCAL      22000 UID_IMPLICIT_NETWORK
#   13000 SECURE_VPN  <-- critical 23000 IMPLICIT_NETWORK
#   14000 PROHIBIT_NON_VPN         24000 BYPASSABLE_VPN_NO_LOCAL_EXCLUSION
#   15000 UID_EXPLICIT_NETWORK     25000 UID_LOCAL_ROUTES
#   16000 EXPLICIT_NETWORK         26000 LOCAL_ROUTES
#   17000 OUTPUT_INTERFACE         27000 BYPASSABLE_VPN_LOCAL_EXCLUSION
#   18000 LEGACY_SYSTEM            28000 VPN_FALLTHROUGH
#   19000 LEGACY_NETWORK           29000 UID_DEFAULT_NETWORK
#                                  30000 UID_DEFAULT_UNREACHABLE
#                                  31000 DEFAULT_NETWORK
#                                  32000 UNREACHABLE
#
# 13000 (SECURE_VPN) must never be clobbered by an in-place update - that is the
# rule carrying an always-on VPN. PROBE: `ip rule show` on the device is the
# live truth; this table is the expectation to compare it against.
TETHYS_NETD_CRITICAL_PRIORITY="13000"
TETHYS_NETD_PROBE_CMD="ip rule show"

# ----------------------------------------------------------------- battery policy
# Claim under test: "Tethys does not battery drain." The profile carries the
# knobs; the claim is only allowed to be made after a measured idle comparison.
TETHYS_IDLE_TARGET="daemon idle CPU near 0% and no periodic wakeup storm"
TETHYS_MEASURE_IDLE="dumpsys batterystats --charged com.tethys.tailscaled; top -b -n 1"

# ----------------------------------------------------------------- probed at first run
# Everything here is written by the module's probe script into
# tethys.runtime.env; nothing here may be authored by hand.
TETHYS_PROBE_KEYS="ro.product.device ro.product.model ro.build.version.sdk ro.build.version.release uname.r kernel.version netd.rule_priorities tun.opened_by fwmark.free_bits"
